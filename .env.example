# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (required for admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CRON authentication (min 16 chars, optional in dev)
CRON_SECRET=your-cron-secret-min-16-chars

# Encryption (64 chars hex = 256 bits, optional in dev, required in prod)
# Protege les API keys tenants stockees en DB. Generer avec :
#   openssl rand -hex 32
# Voir docs/SECURITY.md pour la procedure de rotation.
ENCRYPTION_KEY=your-encryption-key-64-hex-chars

# Odoo - push factures/avoirs et pull paiements
# Si une seule variable manque, le client retombe sur un stub (no-op)
ODOO_URL=https://your-tenant.odoo.com
ODOO_DB=your-db-name
ODOO_USERNAME=integration@example.com
ODOO_API_KEY=your-odoo-api-key

# Resend - envoi emails (factures, relances, digests)
# Si absent: emails skipped + log warning
RESEND_API_KEY=re_your-resend-key

# Email override (staging/demo) - redirige TOUS les emails sortants
# vers cette adresse, prefixe sujet "[DEMO -> original@x.com]"
# NE JAMAIS positionner en prod reelle
EMAIL_OVERRIDE=test@example.com

# Sentry - error tracking (no-op si DSN absent)
SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# Upstash Redis - rate limit auth (auto-provisionne par Vercel Marketplace)
# Fail-open si manquant
UPSTASH_REDIS_REST_KV_REST_API_URL=https://...
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=...

# Giphy - recherche GIF dans le chat equipe (optionnel)
GIPHY_API_KEY=your-giphy-key

# Avatar freeze unlock secret - easter egg (optionnel)
# Réponse de l'énigme du robot (page Mon compte : 5 clics sur l'avatar).
# Normalisé côté serveur (casse/accents/ponctuation ignorés) -> la forme exacte
# n'a pas d'importance.
AVATAR_UNLOCK_SECRET=la-reponse-de-lenigme

# Eduvia API base URL - resolution endpoint pour les sync legacy.
# Si absent, le client tente une derivation depuis l'instance_url tenant.
EDUVIA_API_BASE_URL=https://api.eduvia.io

# Eduvia Quality API mode - 'mock' active le referentiel factice (dev/tests).
# Sinon: 'real' (par defaut), exige une cle API tenant valide.
EDUVIA_QUALITY_API_MODE=real

# URL publique du site - utilisee pour les redirectTo Supabase Auth (reset
# password, magic link). Doit etre l'origine prod en prod, localhost en dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI - triage IA des bug reports (vision). Optionnel: si absent, le bug
# report part sans synthese IA (ai_status='skipped').
OPENAI_API_KEY=sk-your-openai-key

# Destinataire des emails de bug reports. Optionnel (fallback admin principal).
ADMIN_BUG_REPORT_EMAIL=bugs@example.com

# Secret du webhook Odoo move-cancelled (base_automation). Optionnel: la route
# repond 503 si absent, le cron horaire sert de filet.
ODOO_WEBHOOK_SECRET=your-odoo-webhook-secret

# Fan-out du webhook Odoo vers FINANCES-WISEMANH (best-effort). Optionnels.
FINANCES_WEBHOOK_URL=https://finances.example.com/api/webhooks/odoo
FINANCES_WEBHOOK_TOKEN=your-finances-webhook-token

# Token miroir des lignes bancaires pousse par FINANCES (header x-finances-token).
BANK_LINES_MIRROR_TOKEN=your-bank-lines-mirror-token

# Token du registre public des societes emettrices Odoo (header x-registry-token).
# La route repond 503 si absent.
REGISTRY_TOKEN=your-registry-token

# Secret du webhook LinkedIn (ingest prospects). La route rejette si absent.
LINKEDIN_WEBHOOK_SECRET=your-linkedin-webhook-secret

# Yousign - signature electronique (optionnel: sans cle, mode manuel).
YOUSIGN_API_KEY=your-yousign-api-key
# Base URL API Yousign (defaut: https://api.yousign.app/v3, sandbox possible).
YOUSIGN_BASE_URL=https://api.yousign.app/v3
# Secret HMAC de verification des webhooks Yousign.
YOUSIGN_WEBHOOK_SECRET=your-yousign-webhook-secret
